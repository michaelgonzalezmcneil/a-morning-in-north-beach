{
  "name": "a-morning-in-north-beach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "prebuild": "node scripts/content.mjs",
    "predev": "node scripts/content.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.html docs/*.md README.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "phaser": "^3.90.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
